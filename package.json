{
  "name": "kxco-pq-tls",
  "version": "1.5.0",
  "description": "Post-quantum encrypted channels for Node.js streams and WebSockets. Hybrid ML-KEM-768 (NIST FIPS 203) and X25519 key exchange, so a recorded session stays closed unless both are broken, with AES-256-GCM records and optional ML-DSA-87 or ML-DSA-65 identity keys.",
  "keywords": [
    "post-quantum",
    "pqc",
    "ml-kem",
    "kyber",
    "x25519",
    "tls",
    "secure-channel",
    "cloudflare-workers",
    "nist",
    "fips-203",
    "kxco",
    "hybrid-kem",
    "aes-256-gcm",
    "websocket",
    "node-stream",
    "mutual-auth",
    "end-to-end-encryption",
    "encrypted-channel",
    "pqc-migration",
    "harvest-now-decrypt-later",
    "crypto-agility",
    "hybrid-key-exchange",
    "x25519mlkem768",
    "data-in-transit",
    "ml-dsa",
    "ml-dsa-87"
  ],
  "license": "Apache-2.0",
  "author": "Shayne Heffernan and John Heffernan",
  "contributors": [
    {
      "name": "Shayne Heffernan"
    },
    {
      "name": "John Heffernan"
    }
  ],
  "homepage": "https://kxco.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-tls.git"
  },
  "bugs": {
    "url": "https://github.com/KnightsbridgeAIQ/kxco-pq-tls/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "TLS.md",
    "src",
    "ASSESSMENT.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "kxco-post-quantum": "^1.6.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=15000 test/primitives.test.js test/handshake.test.js test/stream.test.js test/websocket.test.js test/property.test.js",
