  },
  "funding": "https://kxco.ai",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "kxco-pq-tls-140": "npm:kxco-pq-tls@1.4.0"
  }
}
